{
  "name": "zagros-baban/expense-tracker-system",
  "description": "A PHP and MySQL web application for tracking personal expenses, budgets, recurring payments, and reports.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "lint": "phpunit --no-coverage --filter SyntaxCheckTest",
    "test": "phpunit --no-coverage",
    "test:coverage": "phpunit --coverage-text --coverage-clover build/coverage/clover.xml --coverage-html build/coverage/html",
    "build": "@php build.php",
    "ci": [
      "@lint",
      "@test:coverage"
    ]
  }
}
